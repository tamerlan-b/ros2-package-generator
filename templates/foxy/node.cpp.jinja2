{% from 'foxy/qos_macros.jinja2' import generate_qos_expression %}
{% if node_ns %}
namespace {{ node_ns }}
{
{% endif %}

{{ node_classname }}::{{ node_classname }}({% if is_component %}const rclcpp::NodeOptions& options{% endif %}): Node("{{ node_name }}"{% if is_component %}, options{% endif %})
{
    {% if tf_listener %}
    // TF
    this->tf_buffer = std::make_shared<tf2_ros::Buffer>(this->get_clock());
    this->tf_listener = std::make_shared<tf2_ros::TransformListener>(*this->tf_buffer);
    {% endif %}
    {% if params %}
    // Params
    {% endif %}
    {% for par in params %}
    auto {{ par.name }} = this->declare_parameter<{{ par.type }}>("{{ par.name }}", {{ par.default }});
    {% endfor %}
    
    {% if publishers %}
    // Publishers
    {% endif %}
    {% for pub in publishers %}
    {% if is_component and pub.qos.is_transient_local %}
    rclcpp::PublisherOptions {{ pub.var_name }}_opts;
    {{ pub.var_name }}_opts.use_intra_process_comm = rclcpp::IntraProcessSetting::Disable;
    {% endif %}
    {% block pub_init scoped %}
    this->{{ pub.var_name }} = this->create_publisher<{{ pub.msg_type }}>(
        "{{ pub.topic }}", 
        {{ generate_qos_expression(pub.qos) }}
        {% if is_component and pub.qos.is_transient_local %}
        , {{ pub.var_name }}_opts
        {% endif %}
    );
    {% endblock %}
    {% endfor %}
    
    {% if subscribers %}
    // Subscribers
    {% endif %}
    {% for sub in subscribers %}
    {% if is_component and sub.qos.is_transient_local %}
    rclcpp::SubscriptionOptions {{ sub.var_name }}_opts{};
    {{ sub.var_name }}_opts.use_intra_process_comm = rclcpp::IntraProcessSetting::Disable;
    {% endif %}
    {% block sub_init scoped %}
    this->{{ sub.var_name }} = this->create_subscription<{{ sub.msg_type }}>(
        "{{ sub.topic }}", 
        {{ generate_qos_expression(sub.qos) }}, 
        [&]({{ sub.msg_type }}{{ sub.callback_arg_type }} msg) { this->{{ sub.callback }}(std::move(msg)); }
        {% if is_component and sub.qos.is_transient_local %}
        , {{ sub.var_name }}_opts
        {% endif %}
    );
    {% endblock %}
    {% endfor %}

    {% if timers %}
    // Timers
    {% endif %}
    {% for tim in timers %}
    this->{{ tim.var_name }} = this->create_wall_timer({{ tim.period }}ms, [&](){ this->{{ tim.callback }}(); });
    {% endfor %}

    {% if services %}
    // Services
    {% endif %}
    {% for srv in services %}
    this->{{ srv.var_name }} = this->create_service<{{ srv.type }}>("{{ srv.name }}", 
      [this](const std::shared_ptr<{{ srv.type }}::Request> request, std::shared_ptr<{{ srv.type }}::Response> response){ this->{{ srv.callback }}(std::move(request), std::move(response)); }
    );
    {% endfor %}
    
    {% if clients %}
    // Clients
    {% endif %}
    {% for client in clients %}
    this->{{ client.var_name }} = this->create_client<{{ client.type }}>("{{ client.srv_name }}");
    {% endfor %}
    {% if clients %}
    // TODO: add waiting for services
    {% endif %}

    {% if action_servers %}
    // Action servers
    {% endif %}
    {% for action_srv in action_servers %}
    this->{{ action_srv.var_name }} = rclcpp_action::create_server<{{ action_srv.type }}>(
        this,
        "{{ action_srv.name }}",
        [this](const rclcpp_action::GoalUUID & uuid, std::shared_ptr<const {{ action_srv.type }}::Goal> goal){return this->{{ action_srv.handle_goal }}(std::move(uuid), std::move(goal));},
        [this](const std::shared_ptr<rclcpp_action::ServerGoalHandle<{{ action_srv.type }}>> goal_handle){return this->{{ action_srv.handle_cancel }}(std::move(goal_handle));},
        [this](const std::shared_ptr<rclcpp_action::ServerGoalHandle<{{ action_srv.type }}>> goal_handle){this->{{ action_srv.handle_accepted }}(std::move(goal_handle));}
    );
    {% endfor %}

    {% if action_clients %}
    // Action clients
    {% endif %}
    {% for action_client in action_clients %}
    this->{{ action_client.var_name }} = rclcpp_action::create_client<{{ action_client.type }}>(
      this,
      "{{ action_client.srv_name}}");

    this->{{ action_client.var_name }}_once_timer = this->create_wall_timer(
      std::chrono::milliseconds(500),
      [&](){ this->{{ action_client.var_name }}_once_timer_cb(); });
    {% endfor %}
    
    {% if sync_subscribers %}
    // Synchronized subscribers (message_filters)
    {% endif %}
    {% if sync_subscribers %}
    using namespace std::placeholders;
    {% endif %}
    {% for i in range(sync_subscribers|length) %}
        {% for sub in  sync_subscribers[i].subs %}
    rclcpp::QoS {{ sub.var_name }}_qos(4);
    this->{{ sub.var_name }} = std::make_shared<message_filters::Subscriber<{{ sub.msg_type }}>>(this, "{{ sub.topic }}", {{ sub.var_name }}_qos.get_rmw_qos_profile());
        {% endfor %}
    this->{{ sync_subscribers[i].var_name }} = std::make_shared<message_filters::Synchronizer<SyncPolicy{{ i+1 }}_t>>(
        SyncPolicy{{ i+1 }}_t({{ sync_subscribers[i].queue_size }}{% if sync_subscribers[i].sync_policy == 'ApproximateEpsilonTime' %}, rclcpp::Duration::from_seconds({{ sync_subscribers[i].epsilon }} * 0.001){% endif %}), 
        {% for j in range(sync_subscribers[i].subs|length) %}
        *{{ sync_subscribers[i].subs[j].var_name }}{% if not loop.last %},{% endif %} 
        {% endfor %}
    );
    this->{{ sync_subscribers[i].var_name }}->registerCallback(
    std::bind(&{{ node_classname }}::{{ sync_subscribers[i].callback }}, this, {% for i in range(sync_subscribers[i].subs|length) %}_{{ i+1 }}{% if not loop.last %},{% endif %} {% endfor %}));
    {% endfor %}
}

