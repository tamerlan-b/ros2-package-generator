{% for action_srv in action_servers %}
rclcpp_action::GoalResponse {{ node_classname }}::{{ action_srv.handle_goal }}([[maybe_unused]] const rclcpp_action::GoalUUID & uuid, std::shared_ptr<const {{ action_srv.type }}::Goal> goal)
{
    // TODO: add implementation
    return rclcpp_action::GoalResponse::ACCEPT_AND_EXECUTE;
}
rclcpp_action::CancelResponse {{ node_classname }}::{{ action_srv.handle_cancel }}(const std::shared_ptr<rclcpp_action::ServerGoalHandle<{{ action_srv.type }}>> goal_handle)
{
    // TODO: add implementation
    return rclcpp_action::CancelResponse::ACCEPT;
}
void {{ node_classname }}::{{ action_srv.handle_accepted }}(const std::shared_ptr<rclcpp_action::ServerGoalHandle<{{ action_srv.type }}>> goal_handle)
{
    // TODO: change implementation if necessary
    std::thread{[this, goal_handle](){this->{{ action_srv.execute }}(goal_handle);}}.detach();
}
void {{ node_classname }}::{{ action_srv.execute }}(const std::shared_ptr<rclcpp_action::ServerGoalHandle<{{ action_srv.type }}>> goal_handle)
{
    // TODO: add implementation
    rclcpp::Rate loop_rate(1);
    auto feedback = std::make_shared<{{ action_srv.type }}::Feedback>();
    auto result = std::make_shared<{{ action_srv.type }}::Result>();
    // TODO: change loop condition
    const size_t num_steps = 10;
    for (size_t i = 0; (i < num_steps) && rclcpp::ok(); ++i)
    {
        if (goal_handle->is_canceling())
        {
            // TODO: update result
            goal_handle->canceled(result);
            return;
        }
        // TODO: update feedback
        goal_handle->publish_feedback(feedback);
        loop_rate.sleep();
    }
    if (rclcpp::ok())
    {
        // TODO: update result
        goal_handle->succeed(result);
    }
}
{% endfor %}

{% for action_client in action_clients %}
void {{ node_classname }}::{{ action_client.var_name }}_once_timer_cb()
{
    // TODO: change implementation if necessary
    this->{{ action_client.var_name }}_once_timer->cancel();

    if (!this->{{ action_client.var_name }}->wait_for_action_server())
    {
      RCLCPP_ERROR(this->get_logger(), "Action server not available after waiting");
      // rclcpp::shutdown();
    }

    using Action_t = {{ action_client.type }};
    using GoalHandle_t = rclcpp_action::ClientGoalHandle<Action_t>;
    auto goal_msg = Action_t::Goal();
    // TODO: fill goal_msg

    auto goal_options = rclcpp_action::Client<Action_t>::SendGoalOptions();
    {% block goal_response_callback_set scoped %}
    goal_options.goal_response_callback = 
      [this](std::shared_future<GoalHandle_t::SharedPtr> future){this->{{ action_client.goal_response_callback }}(std::move(future));};
    {% endblock %}
    goal_options.feedback_callback =
      [this](GoalHandle_t::SharedPtr gh, const std::shared_ptr<const Action_t::Feedback> feedback){this->{{ action_client.feedback_callback }}(std::move(gh), std::move(feedback));};
    goal_options.result_callback =
      [this](const GoalHandle_t::WrappedResult & result){this->{{ action_client.result_callback }}(std::move(result));};
    this->{{ action_client.var_name }}->async_send_goal(goal_msg, goal_options);
}

{% block goal_response_callback_def scoped %}
void {{ node_classname }}::{{ action_client.goal_response_callback }}(std::shared_future<rclcpp_action::ClientGoalHandle<{{ action_client.type }}>::SharedPtr> future)
{
    // TODO: change implementation if necessary
    auto goal_handle = future.get();
    if (!goal_handle)
    {
      RCLCPP_ERROR(this->get_logger(), "Goal was rejected by server");
    }
    else
    {
      RCLCPP_INFO(this->get_logger(), "Goal accepted by server, waiting for result");
    }
}
{% endblock %}
void {{ node_classname }}::{{ action_client.feedback_callback }}(
    rclcpp_action::ClientGoalHandle<{{ action_client.type }}>::SharedPtr gh, 
    const std::shared_ptr<const {{ action_client.type }}::Feedback> feedback)
{
    // TODO: add implementation
}
void {{ node_classname }}::{{ action_client.result_callback }}(const rclcpp_action::ClientGoalHandle<{{ action_client.type }}>::WrappedResult & result)
{
    // TODO: change implementation if necessary
    switch (result.code)
    {
        case rclcpp_action::ResultCode::SUCCEEDED:
            break;
        case rclcpp_action::ResultCode::ABORTED:
            RCLCPP_ERROR(this->get_logger(), "Goal was aborted");
            return;
        case rclcpp_action::ResultCode::CANCELED:
            RCLCPP_ERROR(this->get_logger(), "Goal was canceled");
            return;
        default:
            RCLCPP_ERROR(this->get_logger(), "Unknown result code");
            return;
    }
}
